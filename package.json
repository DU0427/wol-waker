{
  "name": "wol-waker",
  "version": "0.1.0",
  "description": "远程唤醒电脑：UDP 直发魔术包，Windows + Android 共用",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node src/core/core.test.mjs",
    "sync:web": "node scripts/sync-web.mjs",
    "electron": "npm run sync:web && electron .",
    "dist:win": "npm run sync:web && electron-builder --win portable",
    "icons": "electron scripts/render-icon.cjs && node scripts/make-android-icons.cjs && node scripts/make-ico.cjs",
    "cap:add": "npm run sync:web && npx cap add android",
    "cap:sync": "npm run sync:web && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.wolwaker.app",
    "productName": "wol-waker",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "wol-waker-${version}-win-x64.exe"
    }
  }
}
