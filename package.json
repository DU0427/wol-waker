{
  "name": "wol-waker",
  "version": "0.1.0",
  "description": "远程唤醒电脑：UDP 直发魔术包，Windows + Android 共用",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node src/core/core.test.mjs",
    "electron": "electron .",
    "dist:win": "electron-builder --win portable",
    "cap:sync": "npx cap sync"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "build": {
    "appId": "com.wolwaker.app",
    "productName": "wol-waker",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "wol-waker-${version}-win-x64.exe"
    }
  }
}
